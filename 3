def get_user_dxf_files(user_id: int) -> list[Path]:
    prefix = f"user_{user_id}_"
    files = [f for f in WORK_DIR.glob(f"{prefix}*.dxf")]
    return sorted(files, key=lambda x: x.stat().st_mtime, reverse=True)


def get_display_name(path: Path, user_id: int) -> str:
    prefix = f"user_{user_id}_"
    name = path.name
    if name.startswith(prefix):
        return name[len(prefix):]
    return name


def parse_points_from_txt(text: str) -> list[tuple[float, float, float]]:
    points = []
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = re.split(r"[,\s]+", line)
        parts = [p for p in parts if p]
        if len(parts) < 2:
            continue
        try:
            x = float(parts[0])
            y = float(parts[1])
            z = float(parts[2]) if len(parts) >= 3 else 0.0
            points.append((x, y, z))
        except ValueError:
            continue
    return points


def add_points_to_dxf(dxf_path: Path, points: list) -> int:
    """
    points: список кортежей вида (номер_точки, x, y, z)
    """
    if dxf_path.exists():
        doc = ezdxf.readfile(dxf_path)
    else:
        doc = ezdxf.new(dxfversion="R2010")
        doc.units = units.M

    msp = doc.modelspace()

    if "POINTS" not in doc.layers:
        doc.layers.add("POINTS", color=1)

    # Создаем блок с атрибутом ID, если его еще нет в файле
    if "POINT_WITH_ID" not in doc.blocks:
        point_block = doc.blocks.new(name="POINT_WITH_ID")
        # Геометрия точки
        point_block.add_point((0, 0), dxfattribs={"layer": "POINTS"})
        # Текстовый атрибут для номера
        point_block.add_attdef(
            tag="ID",
            insert=(0.15, 0.15),  # Смещение текста относительно точки
            dxfattribs={
                "layer": "POINTS",
                "height": 2.5,  # Высота шрифта номера
                "style": "Standard",
            },
        )

    # Добавляем точки
    for point_data in points:
        point_id = point_data[0]
        x, y, z = point_data[1], point_data[2], point_data[3]

        block_ref = msp.add_blockref(
            "POINT_WITH_ID",
            (x, y),
            dxfattribs={"layer": "POINTS"},
        )
        # Присваиваем конкретному блоку его номер
        block_ref.add_auto_attribs({"ID": str(point_id)})

    doc.saveas(dxf_path)
    return len(points)


def dxf_to_pdf(dxf_path: Path, pdf_path: Path) -> bool:
    try:
        doc = ezdxf.readfile(dxf_path)
        drawing_matplotlib.qsave(doc.modelspace(), str(pdf_path), dpi=150)
        return True
    except Exception as e:
        logger.error(f"Ошибка конвертации в PDF: {e}")
        return False


async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "Пришлите .txt файл с координатами точек.\n\n"
        "Формат:\n"
        "x y\n"
        "или x y z\n"
        "или x,y,z\n\n"
        "Точкам будут присвоены порядковые номера из файла.\n\n"
        "Команды:\n"
        "/list — список ваших DXF-файлов\n"
        "/pdf — сделать PDF из любого файла\n"
        "/cancel — отмена"
    )


async def list_files(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    files = get_user_dxf_files(user_id)

    if not files:
        await update.message.reply_text("У вас пока нет DXF-файлов.")
        return

    text = "Ваши DXF-файлы:\n\n"
    for i, f in enumerate(files, 1):
        name = get_display_name(f, user_id)
        size_kb = f.stat().st_size / 1024
        text += f"{i}. {name}  ({size_kb:.1f} КБ)\n"

    await update.message.reply_text(text)


async def handle_txt(update: Update, context: ContextTypes.DEFAULT_TYPE):
    document = update.message.document
    if not document or not (document.file_name or "").lower().endswith(".txt"):
        await update.message.reply_text("Нужен файл с расширением .txt")
        return ConversationHandler.END

    await update.message.reply_text("Читаю файл с точками...")

    file = await context.bot.get_file(document.file_id)
    txt_path = WORK_DIR / f"user_{update.effective_user.id}_points.txt"
    await file.download_to_drive(txt_path)

    try:
        text = txt_path.read_text(encoding="utf-8", errors="ignore")
    except Exception as e:
        await update.message.reply_text(f"Не удалось прочитать файл: {e}")
        return ConversationHandler.END

    raw_points = parse_points_from_txt(text)
    if not raw_points:
        await update.message.reply_text("Не нашёл ни одной валидной точки.")
        return ConversationHandler.END

    # Добавляем порядковые номера (начиная с 1)
    points_with_ids = [(i + 1, x, y, z) for i, (x, y, z) in enumerate(raw_points)]
    context.user_data["points"] = points_with_ids

    user_id = update.effective_user.id
    files = get_user_dxf_files(user_id)

    msg = f"Найдено точек: {len(points_with_ids)}\n\n"

    if files:
        msg += "Ваши DXF-файлы:\n"
        for i, f in enumerate(files, 1):
            name = get_display_name(f, user_id)
            msg += f"{i}. {name}\n"
        msg += "\nОтветьте номером, напишите имя или пришлите DXF-файл.\n"
    else:
        msg += "У вас пока нет DXF-файлов.\n"
        msg += "Напишите имя нового файла (например: scheme.dxf)\n"
        msg += "или пришлите DXF-файл.\n"

    msg += "\n/cancel — отмена"
    await update.message.reply_text(msg)
    return WAITING_DXF


async def handle_dxf_or_name(update: Update, context: ContextTypes.DEFAULT_TYPE):
    points = context.user_data.get("points")
    if not points:
        await update.message.reply_text("Сначала отправьте TXT с точками.")
        return ConversationHandler.END

    user_id = update.effective_user.id
    dxf_path = None
    files = get_user_dxf_files(user_id)

    if update.message.document:
        document = update.message.document
        file_name = document.file_name or ""
        if not file_name.lower().endswith(".dxf"):
            await update.message.reply_text("Нужен .dxf файл или номер/имя.")
            return WAITING_DXF

        file = await context.bot.get_file(document.file_id)
        safe_name = re.sub(r'[\\/*?:"<>|]', "_", file_name)
        dxf_path = WORK_DIR / f"user_{user_id}_{safe_name}"
        await file.download_to_drive(dxf_path)

    elif update.message.text:
        text = update.message.text.strip()

        if text.isdigit():
            idx = int(text) - 1
            if 0 <= idx < len(files):
                dxf_path = files[idx]
            else:
                await update.message.reply_text("Неверный номер. Попробуйте ещё раз.")
                return WAITING_DXF
        else:
            name = text
            if not name.lower().endswith(".dxf"):
                name += ".dxf"
            name = re.sub(r'[\\/*?:"<>|]', "_", name)
            dxf_path = WORK_DIR / f"user_{user_id}_{name}"
    else:
        await update.message.reply_text("Пришлите DXF, номер или имя файла.")
        return WAITING_DXF

    await update.message.reply_text("Добавляю точки...")

    try:
        added = add_points_to_dxf(dxf_path, points)
        doc = ezdxf.readfile(dxf_path)
        total = len(list(doc.modelspace().query("POINT")))
    except Exception as e:
        await update.message.reply_text(f"Ошибка: {e}")
        return ConversationHandler.END

    display_name = get_display_name(dxf_path, user_id)

    # Сохраняем путь для кнопки
    context.user_data["last_dxf"] = str(dxf_path)

    # Кнопка "Сделать PDF"
    keyboard = InlineKeyboardMarkup(
        [[InlineKeyboardButton("📄 Сделать PDF", callback_data="make_pdf")]]
    )

    await update.message.reply_text(
        f"Готово!\n"
        f"Файл: {display_name}\n"
        f"Добавлено точек: {added}\n"
        f"Всего точек (включая старые): {total}"
    )

    with open(dxf_path, "rb") as f:
        await update.message.reply_document(
            document=f,
            filename=display_name,
            caption="DXF с добавленными точками (номера видны в CAD)",
            reply_markup=keyboard,
        )

    return ConversationHandler.END


async def button_make_pdf(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Обработка нажатия кнопки «Сделать PDF»."""
    query = update.callback_query
    await query.answer()

    dxf_path_str = context.user_data.get("last_dxf")
    if not dxf_path_str:
        await query.edit_message_caption(caption="Файл уже не найден. Сделайте операцию заново.")
        return

    dxf_path = Path(dxf_path_str)
    if not dxf_path.exists():
        await query.edit_message_caption(caption="Файл не найден на сервере.")
        return

    await query.edit_message_caption(caption="Делаю PDF...")

    pdf_path = dxf_path.with_suffix(".pdf")
    user_id = update.effective_user.id

    if dxf_to_pdf(dxf_path, pdf_path):
        display_name = get_display_name(pdf_path, user_id)
        with open(pdf_path, "rb") as f:
            await context.bot.send_document(
                chat_id=query.message.chat_id,
                document=f,
                filename=display_name,
                caption="PDF готов (номера точек могут не отображаться в PDF, только в DXF)",
            )
        await query.edit_message_caption(caption="PDF отправлен ✅")
    else:
        await query.edit_message_caption(caption="Не удалось создать PDF")


async def pdf_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Команда /pdf — выбрать файл из списка."""
    user_id = update.effective_user.id
    files = get_user_dxf_files(user_id)

    if not files:
        await update.message.reply_text("У вас нет DXF-файлов.")
        return ConversationHandler.END

    # Делаем кнопки для каждого файла
    buttons = []
    for i, f in enumerate(files):
        name = get_display_name(f, user_id)
        buttons.append([InlineKeyboardButton(f"{i+1}. {name}", callback_data=f"pdf_{i}")])

    keyboard = InlineKeyboardMarkup(buttons)
    await update.message.reply_text("Выберите файл для PDF:", reply_markup=keyboard)
    return ConversationHandler.END


async def button_pdf_choice(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Обработка выбора файла из /pdf."""
    query = update.callback_query
    await query.answer()

    data = query.data
    if not data.startswith("pdf_"):
        return

    try:
        idx = int(data.split("_")[1])
    except (IndexError, ValueError):
        await query.edit_message_text("Ошибка выбора файла.")
        return

    user_id = update.effective_user.id
    files = get_user_dxf_files(user_id)

    if idx < 0 or idx >= len(files):
        await query.edit_message_text("Файл не найден.")
        return

    dxf_path = files[idx]
    await query.edit_message_text(f"Делаю PDF из «{get_display_name(dxf_path, user_id)}»...")

    pdf_path = dxf_path.with_suffix(".pdf")

    if dxf_to_pdf(dxf_path, pdf_path):
        display_name = get_display_name(pdf_path, user_id)
        with open(pdf_path, "rb") as f:
            await context.bot.send_document(
                chat_id=query.message.chat_id,
                document=f,
                filename=display_name,
                caption="PDF готов",
            )
        await query.edit_message_text("PDF отправлен ✅")
    else:
        await query.edit_message_text("Не удалось создать PDF.")


async def cancel(update: Update, context: ContextTypes.DEFAULT_TYPE):
    context.user_data.clear()
    await update.message.reply_text("Отменено.")
    return ConversationHandler.END


def main():
    app = Application.builder().token(BOT_TOKEN).build()

    conv_handler = ConversationHandler(
        entry_points=[
            MessageHandler(filters.Document.FileExtension("txt"), handle_txt),
        ],
        states={
            WAITING_DXF: [
                MessageHandler(filters.Document.FileExtension("dxf"), handle_dxf_or_name),
                MessageHandler(filters.TEXT & ~filters.COMMAND, handle_dxf_or_name),
            ],
        },
        fallbacks=[CommandHandler("cancel", cancel)],
        allow_reentry=True,
    )

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("list", list_files))
    app.add_handler(CommandHandler("pdf", pdf_command))
    app.add_handler(CommandHandler("cancel", cancel))
    app.add_handler(conv_handler)

    # Обработчики кнопок
    app.add_handler(CallbackQueryHandler(button_make_pdf, pattern="^make_pdf$"))
    app.add_handler(CallbackQueryHandler(button_pdf_choice, pattern="^pdf_"))

    print("Бот запущен...")
    app.run_polling(allowed_updates=Update.ALL_TYPES)


if __name__ == "__main__":
    main()
