async def view_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Показывает превью последнего загруженного TXT файла."""
    txt_path = WORK_DIR / f"user_{update.effective_user.id}_points.txt"
    
    if not txt_path.exists():
        await update.message.reply_text("Сначала пришлите TXT файл, чтобы я мог его показать.")
        return

    try:
        text = txt_path.read_text(encoding="utf-8", errors="ignore")
    except Exception as e:
        await update.message.reply_text(f"Не удалось прочитать файл: {e}")
        return

    # Обрезаем текст, если он слишком длинный для сообщения
    preview = text.strip()[-4000:] # Берем последние 4000 символов (начало файла может быть шапкой)
    if len(text) > 4000:
        preview = "...\n" + preview

    await update.message.reply_text(
        f"📄 <b>Содержимое файла:</b>\n<pre>{preview}</pre>",
        parse_mode="HTML"
    )


async def list_files(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    files = get_user_dxf_files(user_id)
    if not files:
        await update.message.reply_text("У вас пока нет DXF-файлов.")
        return
    text = "Ваши DXF-файлы:\n\n"
    for i, f in enumerate(files, 1):
        name = get_display_name(f, user_id)
        size_kb = f.stat().st_size / 1024
        text += f"{i}. {name}  ({size_kb:.1f} КБ)\n"
    await update.message.reply_text(text)


# --- НОВАЯ ЛОГИКА ОБРАБОТКИ TXT ---
async def handle_txt(update: Update, context: ContextTypes.DEFAULT_TYPE):
    document = update.message.document
    if not document or not (document.file_name or "").lower().endswith(".txt"):
        await update.message.reply_text("Нужен файл с расширением .txt")
        return ConversationHandler.END

    await update.message.reply_text("Сохраняю файл...")
    file = await context.bot.get_file(document.file_id)
    txt_path = WORK_DIR / f"user_{update.effective_user.id}_points.txt"
    await file.download_to_drive(txt_path)

    try:
        text = txt_path.read_text(encoding="utf-8", errors="ignore")
    except Exception as e:
        await update.message.reply_text(f"Не удалось прочитать файл: {e}")
        return ConversationHandler.END

    raw_points = parse_points_from_txt(text)
    if not raw_points:
        await update.message.reply_text("Не нашёл ни одной валидной точки в файле.")
        return ConversationHandler.END

    context.user_data["points"] = raw_points

    # Показываем превью и спрашиваем подтверждение
    preview = text.strip()[-1000:] # Для кнопок показываем хвост файла
    if len(text) > 1000:
        preview = "...\n" + preview

    keyboard = InlineKeyboardMarkup([
        [InlineKeyboardButton("✅ Продолжить", callback_data="confirm_yes")],
        [InlineKeyboardButton("❌ Отмена", callback_data="confirm_no")]
    ])

    await update.message.reply_text(
        f"Найдено точек: <b>{len(raw_points)}</b>\n\n"
        f"Проверьте данные:\n<pre>{preview}</pre>",
        reply_markup=keyboard,
        parse_mode="HTML"
    )
    return WAITING_CONFIRM


