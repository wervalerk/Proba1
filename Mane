async def handle_dxf_input(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Обработка загрузки DXF или ввода имени."""
    user_id = update.effective_user.id

    # Загрузка DXF
    if update.message.document and context.user_data.get("waiting_upload"):
        doc = update.message.document
        if not (doc.file_name or "").lower().endswith(".dxf"):
            await update.message.reply_text("Нужен файл с расширением .dxf")
            return WAITING_DXF_CHOICE

        file = await context.bot.get_file(doc.file_id)
        safe_name = re.sub(r'[\\/*?:"<>|]', "_", doc.file_name)
        dxf_path = WORK_DIR / f"user_{user_id}_{safe_name}"
        await file.download_to_drive(dxf_path)
        context.user_data["dxf_path"] = str(dxf_path)
        context.user_data.pop("waiting_upload", None)

        await update.message.reply_text(f"Файл «{safe_name}» загружен.")
        await ask_sizes_message(update, context)
        return WAITING_SIZES

    # Ввод своего имени
    if context.user_data.get("waiting_custom_name") and update.message.text:
        name = update.message.text.strip()
        if not name.lower().endswith(".dxf"):
            name += ".dxf"
        name = re.sub(r'[\\/*?:"<>|]', "_", name)
        dxf_path = WORK_DIR / f"user_{user_id}_{name}"
        context.user_data["dxf_path"] = str(dxf_path)
        context.user_data.pop("waiting_custom_name", None)

        await ask_sizes_message(update, context)
        return WAITING_SIZES

    await update.message.reply_text("Пришлите DXF или напишите имя файла.")
    return WAITING_DXF_CHOICE


