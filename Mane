def get_user_dxf_files(user_id: int):
    prefix = f"user_{user_id}_"
    files = list(WORK_DIR.glob(f"{prefix}*.dxf"))
    return sorted(files, key=lambda x: x.stat().st_mtime, reverse=True)


def get_display_name(path: Path, user_id: int) -> str:
    prefix = f"user_{user_id}_"
    name = path.name
    if name.startswith(prefix):
        return name[len(prefix):]
    return name


def parse_points_from_txt(text: str):
    points = []
    lines = text.splitlines()
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = re.split(r"[,\s;]+", line)
        parts = [p for p in parts if p]
        if len(parts) < 2:
            continue
        nums = []
        for p in parts:
            if "," in p and "." not in p:
                p = p.replace(",", ".")
            try:
                nums.append(float(p))
            except ValueError:
                continue
        if len(nums) < 2:
            continue
        if len(nums) >= 3 and nums[0].is_integer():
            point_id = int(nums[0])
            x, y, z = nums[1], nums[2], nums[3] if len(nums) > 3 else 0.0
        else:
            point_id = -1 
            x, y, z = nums[0], nums[1], nums[2] if len(nums) > 2 else 0.0
        points.append((point_id, x, y, z))

    final_points = []
    current_id = 1
    for pid, x, y, z in points:
        if pid == -1:
            final_points.append((current_id, x, y, z))
            current_id += 1
        else:
            final_points.append((pid, x, y, z))
    return final_points


def add_points_to_dxf(dxf_path: Path, points: list) -> int:
    if dxf_path.exists():
        doc = ezdxf.readfile(dxf_path)
    else:
        doc = ezdxf.new(dxfversion="R2010")
        doc.units = units.M

    msp = doc.modelspace()
    if "POINTS" not in doc.layers:
        doc.layers.add("POINTS", color=1)
    if "TEXT" not in doc.layers:
        doc.layers.add("TEXT", color=5)

    if "POINT_WITH_ID" not in doc.blocks:
        point_block = doc.blocks.new(name="POINT_WITH_ID")
        size = 0.5
        point_block.add_line(start=(-size/2, 0), end=(size/2, 0), dxfattribs={"layer": "POINTS", "color": 1})
        point_block.add_line(start=(0, -size/2), end=(0, size/2), dxfattribs={"layer": "POINTS", "color": 1})
        point_block.add_point((0, 0), dxfattribs={"layer": "POINTS"})
        point_block.add_attdef(tag="ID", insert=(size/2 + 0.5, size/2 + 0.2), dxfattribs={"layer": "TEXT", "height": 5.0, "style": "Standard"})

    xs = [p[1] for p in points]
    ys = [p[2] for p in points]
    if xs and ys:
        span = max(max(xs) - min(xs), max(ys) - min(ys), 1.0)
        text_height = max(span / 200.0, 2.0)
    else:
        text_height = 2.5

    for point_data in points:
        point_id = point_data[0]
        x, y, z = point_data[1], point_data[2], point_data[3]
        block_ref = msp.add_blockref("POINT_WITH_ID", (x, y), dxfattribs={"layer": "POINTS"})
        block_ref.add_auto_attribs({"ID": str(point_id)})
        block_ref.attribs["ID"].dxf.height = text_height
        if z != 0.0:
            block_ref.dxf.z = z

    doc.saveas(dxf_path)
    return len(points)


def dxf_to_pdf(dxf_path: Path, pdf_path: Path) -> bool:
    try:
        doc = ezdxf.readfile(dxf_path)
        drawing_matplotlib.qsave(doc.modelspace(), str(pdf_path), dpi=150)
        return True
    except Exception as e:
        logger.error(f"Ошибка конвертации в PDF: {e}")
        return False


