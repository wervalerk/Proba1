def get_user_dxf_files(user_id: int):
    prefix = f"user_{user_id}_"
    files = list(WORK_DIR.glob(f"{prefix}*.dxf"))
    return sorted(files, key=lambda x: x.stat().st_mtime, reverse=True)


def get_display_name(path: Path, user_id: int) -> str:
    prefix = f"user_{user_id}_"
    name = path.name
    return name[len(prefix):] if name.startswith(prefix) else name


def parse_points_from_txt(text: str):
    points = []
    auto_id = 1
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = re.split(r"[,;\s]+", line)
        parts = [p.strip() for p in parts if p.strip()]
        if len(parts) < 2:
            continue
        nums = []
        for p in parts:
            if "," in p and "." not in p:
                p = p.replace(",", ".")
            try:
                nums.append(float(p))
            except ValueError:
                continue
        if len(nums) < 2:
            continue
        if len(nums) >= 3 and nums[0].is_integer():
            point_id = int(nums[0])
            x, y = nums[1], nums[2]
            z = nums[3] if len(nums) > 3 else 0.0
        else:
            point_id = auto_id
            x, y = nums[0], nums[1]
            z = nums[2] if len(nums) > 2 else 0.0
            auto_id += 1
        points.append((point_id, x, y, z))
    return points


def calculate_auto_sizes(points):
    if len(points) < 2:
        return 0.7, 0.9
    min_dist = float('inf')
    for i in range(len(points)):
        for j in range(i + 1, len(points)):
            dx = points[i][1] - points[j][1]
            dy = points[i][2] - points[j][2]
            dist = (dx*dx + dy*dy) ** 0.5
            if 0.01 < dist < min_dist:
                min_dist = dist
    if min_dist == float('inf'):
        min_dist = 2.0
    cross = max(min(min_dist * 0.28, 2.0), 0.35)
    text = max(min(min_dist * 0.38, 2.5), 0.5)
    return round(cross, 2), round(text, 2)


def create_preview_image(points, cross_size, text_height, out_path: Path):
    fig, ax = plt.subplots(figsize=(10, 8), dpi=120)
    xs = [p[1] for p in points]
    ys = [p[2] for p in points]
    ids = [str(p[0]) for p in points]

    ax.scatter(xs, ys, c='red', s=22, zorder=3)
    for x, y, pid in zip(xs, ys, ids):
        ax.text(x + text_height*0.55, y + text_height*0.55, pid,
                fontsize=max(text_height * 7.5, 5.5), color='lime', zorder=4)

    ax.set_aspect('equal', adjustable='datalim')
    ax.grid(True, linestyle='--', alpha=0.35)
    ax.set_title(f"Превью   |   Крест: {cross_size}    Текст: {text_height}", fontsize=12)
    ax.margins(0.07)
    fig.tight_layout()
    fig.savefig(out_path, dpi=120, bbox_inches='tight')
    plt.close(fig)


def add_points_to_dxf(dxf_path: Path, points, cross_size=0.7, text_height=0.9) -> int:
    if dxf_path.exists():
        doc = ezdxf.readfile(dxf_path)
    else:
        doc = ezdxf.new(dxfversion="R2010")
        doc.units = units.M

    msp = doc.modelspace()
    if "POINTS" not in doc.layers:
        doc.layers.add("POINTS", color=1)
    if "TEXT" not in doc.layers:
        doc.layers.add("TEXT", color=3)

    block_name = "POINT_WITH_ID"
    if block_name in doc.blocks:
        doc.blocks.delete_block(block_name, safe=True)

    block = doc.blocks.new(name=block_name)
    TEXT_OFFSET = text_height * 0.65
    CIRCLE_R = max(cross_size * 0.13, 0.05)

    block.add_line((-cross_size/2, 0), (cross_size/2, 0), dxfattribs={"layer": "POINTS", "color": 1})
    block.add_line((0, -cross_size/2), (0, cross_size/2), dxfattribs={"layer": "POINTS", "color": 1})
    block.add_circle((0, 0), radius=CIRCLE_R, dxfattribs={"layer": "POINTS", "color": 1})
    block.add_attdef(tag="ID", insert=(TEXT_OFFSET, TEXT_OFFSET),
                     dxfattribs={"layer": "TEXT", "height": text_height, "style": "Standard"})

    for pid, x, y, z in points:
        ref = msp.add_blockref(block_name, (x, y), dxfattribs={"layer": "POINTS"})
        ref.add_auto_attribs({"ID": str(pid)})
        if z != 0.0:
            ref.dxf.insert = (x, y, z)

    doc.saveas(dxf_path)
    return len(points)


def dxf_to_pdf(dxf_path: Path, pdf_path: Path) -> bool:
    try:
        doc = ezdxf.readfile(dxf_path)
        drawing_matplotlib.qsave(doc.modelspace(), str(pdf_path), dpi=140)
        return True
    except Exception as e:
        logger.error(e)
        return False


