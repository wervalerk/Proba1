def calculate_auto_sizes(points: List[Tuple]) -> Tuple[float, float]:
    if len(points) < 2:
        return 0.7, 0.9
    min_dist = float("inf")
    for i in range(len(points)):
        for j in range(i + 1, len(points)):
            dx = points[i][1] - points[j][1]
            dy = points[i][2] - points[j][2]
            dist = math.hypot(dx, dy)
            if 0.01 < dist < min_dist:
                min_dist = dist
    if min_dist == float("inf"):
        min_dist = 2.0
    cross = max(min(min_dist * 0.28, 2.0), 0.35)
    text = max(min(min_dist * 0.38, 2.5), 0.5)
    return round(cross, 2), round(text, 2)


def create_preview_image(
    points: List[Tuple],
    cross_size: float,
    text_height: float,
    out_path: Path,
    underlay: Optional[DxfGeom] = None,
    title_extra: str = "",
):
    fig, ax = plt.subplots(figsize=(11, 8.5), dpi=130)

    if underlay:
        for pts, closed, _ in underlay.polylines:
            xs = [p[0] for p in pts]
            ys = [p[1] for p in pts]
            if closed and len(pts) >= 3:
                ax.fill(xs, ys, facecolor="#eaf5df", edgecolor="none", zorder=0, alpha=0.7)
            ax.plot(xs, ys, color="#7d7d7d", lw=0.7, zorder=1)

    xs = [p[1] for p in points]
    ys = [p[2] for p in points]
    ids = [str(p[0]) for p in points]

    half = cross_size / 2
    for x, y in zip(xs, ys):
        ax.plot([x - half, x + half], [y, y], color="red", lw=1.1, zorder=3)
        ax.plot([x, x], [y - half, y + half], color="red", lw=1.1, zorder=3)
        ax.plot(x, y, "o", color="red", markersize=3, zorder=4)

    for x, y, pid in zip(xs, ys, ids):
        ax.text(
            x + text_height * 0.55,
            y + text_height * 0.55,
            pid,
            fontsize=max(text_height * 7.0, 5.0),
            color="#1a7a1a",
            zorder=5,
            fontweight="bold",
        )

    ax.set_aspect("equal", adjustable="datalim")
    ax.grid(True, linestyle="--", alpha=0.3)
    title = f"Превью  |  Крест: {cross_size}   Текст: {text_height}"
    if title_extra:
        title += f"  |  {title_extra}"
    ax.set_title(title, fontsize=11)
    ax.margins(0.06)
    fig.tight_layout()
    fig.savefig(out_path, dpi=130, bbox_inches="tight", facecolor="white")
    plt.close(fig)


def add_points_and_underlay_to_dxf(
    dxf_path: Path,
    points: List[Tuple],
    cross_size: float = 0.7,
    text_height: float = 0.9,
    underlay: Optional[DxfGeom] = None,
) -> int:
    doc = ezdxf.new(dxfversion="R2010")
    doc.units = units.M
    doc.header["$INSUNITS"] = 6
    doc.header["$MEASUREMENT"] = 1

    msp = doc.modelspace()

    for name, color in (("PROJ", 8), ("HATCH", 3), ("POINTS", 1), ("TEXT", 3)):
        if name not in doc.layers:
            doc.layers.add(name, color=color)

    if underlay:
        for pts, closed, _ in underlay.polylines:
            xy = [(p[0], p[1]) for p in pts]
            if closed and len(xy) > 2 and math.hypot(xy[-1][0] - xy[0][0], xy[-1][1] - xy[0][1]) < 1e-9:
                xy = xy[:-1]
            msp.add_lwpolyline(
                xy,
                close=closed,
                dxfattribs={"layer": "PROJ", "color": 8},
            )
            if closed and len(xy) >= 3:
                try:
                    h = msp.add_hatch(dxfattribs={"layer": "HATCH", "color": 3})
                    h.set_pattern_fill("ANSI31", scale=max(cross_size * 0.4, 0.02), color=3)
                    h.paths.add_polyline_path(xy, is_closed=True)
                except Exception:
                    pass

    block_name = "POINT_WITH_ID"
    if block_name in doc.blocks:
        doc.blocks.delete_block(block_name, safe=True)

    block = doc.blocks.new(name=block_name)
    TEXT_OFFSET = text_height * 0.65
    CIRCLE_R = max(cross_size * 0.13, 0.04)

    block.add_line(
        (-cross_size / 2, 0), (cross_size / 2, 0),
        dxfattribs={"layer": "POINTS", "color": 1},
    )
    block.add_line(
        (0, -cross_size / 2), (0, cross_size / 2),
        dxfattribs={"layer": "POINTS", "color": 1},
    )
    block.add_circle(
        (0, 0), radius=CIRCLE_R,
        dxfattribs={"layer": "POINTS", "color": 1},
    )
    block.add_attdef(
        tag="ID",
        insert=(TEXT_OFFSET, TEXT_OFFSET),
        dxfattribs={"layer": "TEXT", "height": text_height, "style": "Standard", "color": 3},
    )

    for pid, x, y, z in points:
        ref = msp.add_blockref(block_name, (x, y), dxfattribs={"layer": "POINTS"})
        ref.add_auto_attribs({"ID": str(pid)})
        if abs(z) > 1e-9:
            ref.dxf.insert = (x, y, z)

    doc.saveas(str(dxf_path))
    return len(points)


def dxf_to_pdf(dxf_path: Path, pdf_path: Path) -> bool:
    try:
        doc = ezdxf.readfile(str(dxf_path))
        drawing_matplotlib.qsave(doc.modelspace(), str(pdf_path), dpi=150)
        return True
    except Exception as e:
        logger.error("PDF error: %s", e)
        return False


