async def handle_dxf_or_name(update: Update, context: ContextTypes.DEFAULT_TYPE):
    points = context.user_data.get("points")
    if not points:
        await update.message.reply_text("Сначала отправьте TXT.")
        return ConversationHandler.END

    user_id = update.effective_user.id
    files = get_user_dxf_files(user_id)
    dxf_path = None

    if update.message.document:
        document = update.message.document
        if not (document.file_name or "").lower().endswith(".dxf"):
            await update.message.reply_text("Нужен .dxf файл")
            return WAITING_DXF
        file = await context.bot.get_file(document.file_id)
        safe_name = re.sub(r'[\\/*?:"<>|]', "_", document.file_name)
        dxf_path = WORK_DIR / f"user_{user_id}_{safe_name}"
        await file.download_to_drive(dxf_path)

    elif update.message.text:
        text = update.message.text.strip()
        if text.isdigit():
            idx = int(text) - 1
            if 0 <= idx < len(files):
                dxf_path = files[idx]
            else:
                await update.message.reply_text("Неверный номер.")
                return WAITING_DXF
        else:
            name = text if text.lower().endswith(".dxf") else text + ".dxf"
            name = re.sub(r'[\\/*?:"<>|]', "_", name)
            dxf_path = WORK_DIR / f"user_{user_id}_{name}"
    else:
        await update.message.reply_text("Пришлите DXF или имя файла.")
        return WAITING_DXF

    context.user_data["dxf_path"] = str(dxf_path)

    # Предлагаем размеры
    auto_cross, auto_text = calculate_auto_sizes(points)

    await update.message.reply_text(
        f"Укажите размеры креста и текста.\n\n"
        f"Можно написать:\n"
        f"• <code>auto</code>  (рекомендуется: крест {auto_cross}, текст {auto_text})\n"
        f"• <code>крест 0.6 текст 0.8</code>\n"
        f"• <code>0.7 0.9</code>\n\n"
        f"Или просто отправьте число креста, а текст я подберу.",
        parse_mode="HTML"
    )
    return WAITING_SIZES


async def handle_sizes(update: Update, context: ContextTypes.DEFAULT_TYPE):
    text = (update.message.text or "").strip().lower()
    points = context.user_data.get("points")

    cross_size = 0.7
    text_height = 0.9

    if text == "auto":
        cross_size, text_height = calculate_auto_sizes(points)
    else:
        # Пробуем вытащить числа
        nums = re.findall(r"[\d.,]+", text)
        nums = [float(n.replace(",", ".")) for n in nums]

        if len(nums) >= 2:
            cross_size = nums[0]
            text_height = nums[1]
        elif len(nums) == 1:
            cross_size = nums[0]
            text_height = cross_size * 1.3
        else:
            await update.message.reply_text(
                "Не понял размеры.\n"
                "Напишите <code>auto</code> или например <code>0.6 0.8</code>",
                parse_mode="HTML"
            )
            return WAITING_SIZES

    # Ограничения
    cross_size = max(0.15, min(cross_size, 5.0))
    text_height = max(0.2, min(text_height, 6.0))

    context.user_data["cross_size"] = cross_size
    context.user_data["text_height"] = text_height

    # Делаем превью
    preview_path = WORK_DIR / f"user_{update.effective_user.id}_preview.png"
    create_preview_image(points, cross_size, text_height, preview_path)

    keyboard = InlineKeyboardMarkup([
        [InlineKeyboardButton("✅ Создать DXF", callback_data="create_yes")],
        [InlineKeyboardButton("🔄 Изменить размеры", callback_data="create_change")],
    ])

    with open(preview_path, "rb") as f:
        await update.message.reply_photo(
            photo=f,
            caption=f"Превью\nКрест: <b>{cross_size}</b>   Текст: <b>{text_height}</b>\n\n"
                    f"Всё хорошо?",
            parse_mode="HTML",
            reply_markup=keyboard
        )

    return WAITING_PREVIEW


async def handle_preview_decision(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()

    if query.data == "create_change":
        await query.edit_message_caption(
            caption="Хорошо, укажите новые размеры:\n"
                    "<code>auto</code> или <code>0.5 0.7</code>",
            parse_mode="HTML"
        )
        return WAITING_SIZES

    # Создаём DXF
    points = context.user_data["points"]
    dxf_path = Path(context.user_data["dxf_path"])
    cross_size = context.user_data["cross_size"]
    text_height = context.user_data["text_height"]
    user_id = update.effective_user.id

    await query.edit_message_caption(caption="Создаю DXF...")

    try:
        added = add_points_to_dxf(dxf_path, points, cross_size, text_height)
        total = len(list(ezdxf.readfile(dxf_path).modelspace().query("INSERT")))
    except Exception as e:
        await query.edit_message_caption(caption=f"Ошибка: {e}")
        return ConversationHandler.END

    display_name = get_display_name(dxf_path, user_id)
    context.user_data["last_dxf"] = str(dxf_path)

    keyboard = InlineKeyboardMarkup([
        [InlineKeyboardButton("📄 Сделать PDF", callback_data="make_pdf")]
    ])

    await context.bot.send_message(
        chat_id=query.message.chat_id,
        text=f"✅ Готово!\n"
             f"Файл: <b>{display_name}</b>\n"
             f"Добавлено точек: {added}\n"
             f"Крест: {cross_size}  |  Текст: {text_height}",
        parse_mode="HTML",
        reply_markup=keyboard
    )

    with open(dxf_path, "rb") as f:
        await context.bot.send_document(
            chat_id=query.message.chat_id,
            document=f,
            filename=display_name
        )

    return ConversationHandler.END


async def button_make_pdf(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()

    dxf_path_str = context.user_data.get("last_dxf")
    if not dxf_path_str or not Path(dxf_path_str).exists():
        await query.edit_message_text("Файл не найден.")
        return

    await query.edit_message_text("Создаю PDF...")
    dxf_path = Path(dxf_path_str)
    pdf_path = dxf_path.with_suffix(".pdf")

    if dxf_to_pdf(dxf_path, pdf_path):
        with open(pdf_path, "rb") as f:
            await context.bot.send_document(
                chat_id=query.message.chat_id,
                document=f,
                filename=get_display_name(pdf_path, update.effective_user.id)
            )
        await query.edit_message_text("PDF отправлен ✅")
    else:
        await query.edit_message_text("Не удалось создать PDF")


