def get_user_dxf_files(user_id: int) -> list[Path]:
    prefix = f"user_{user_id}_"
    files = list(WORK_DIR.glob(f"{prefix}*.dxf"))
    return sorted(files, key=lambda x: x.stat().st_mtime, reverse=True)


def get_display_name(path: Path, user_id: int) -> str:
    prefix = f"user_{user_id}_"
    name = path.name
    if name.startswith(prefix):
        return name[len(prefix):]
    return name


def parse_points_from_txt(text: str) -> list[tuple[int, float, float, float]]:
    """
    Поддерживает форматы:
    1 100.5 200.3 15.0
    1,100.5,200.3,15.0
    1 100,5 200,3 15,0
    100.5 200.3
    100,5 200,3 15,0
    """
    points = []
    auto_id = 1

    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue

        # Разделяем по пробелам, запятым и точкам с запятой
        parts = re.split(r"[,;\s]+", line)
        parts = [p.strip() for p in parts if p.strip()]

        if len(parts) < 2:
            continue

        nums = []
        for p in parts:
            # Заменяем запятую на точку, если это десятичный разделитель
            if "," in p and "." not in p:
                p = p.replace(",", ".")
            try:
                nums.append(float(p))
            except ValueError:
                continue

        if len(nums) < 2:
            continue

        # Определяем, есть ли номер точки
        if len(nums) >= 3 and nums[0].is_integer() and nums[0] > 0:
            point_id = int(nums[0])
            x = nums[1]
            y = nums[2]
            z = nums[3] if len(nums) > 3 else 0.0
        else:
            point_id = auto_id
            x = nums[0]
            y = nums[1]
            z = nums[2] if len(nums) > 2 else 0.0
            auto_id += 1

        points.append((point_id, x, y, z))

    return points


def add_points_to_dxf(dxf_path: Path, points: list) -> int:
    if dxf_path.exists():
        doc = ezdxf.readfile(dxf_path)
    else:
        doc = ezdxf.new(dxfversion="R2010")
        doc.units = units.M

    msp = doc.modelspace()

    if "POINTS" not in doc.layers:
        doc.layers.add("POINTS", color=1)
    if "TEXT" not in doc.layers:
        doc.layers.add("TEXT", color=5)

    # Создаём блок с крестом и атрибутом ID
    if "POINT_WITH_ID" not in doc.blocks:
        block = doc.blocks.new(name="POINT_WITH_ID")
        size = 0.8

        # Крест
        block.add_line((-size/2, 0), (size/2, 0), dxfattribs={"layer": "POINTS", "color": 1})
        block.add_line((0, -size/2), (0, size/2), dxfattribs={"layer": "POINTS", "color": 1})
        block.add_point((0, 0), dxfattribs={"layer": "POINTS"})

        # Атрибут номера
        block.add_attdef(
            tag="ID",
            insert=(size/2 + 0.4, size/2 + 0.3),
            dxfattribs={
                "layer": "TEXT",
                "height": 2.5,
                "style": "Standard",
            }
        )

    # Автоматический размер текста в зависимости от размаха точек
    if points:
        xs = [p[1] for p in points]
        ys = [p[2] for p in points]
        span = max(max(xs) - min(xs), max(ys) - min(ys), 1.0)
        text_height = max(span / 180.0, 1.8)
    else:
        text_height = 2.5

    for point_id, x, y, z in points:
        ref = msp.add_blockref(
            "POINT_WITH_ID",
            (x, y),
            dxfattribs={"layer": "POINTS"}
        )
        ref.add_auto_attribs({"ID": str(point_id)})

        # Меняем высоту текста
        if "ID" in ref.attribs:
            ref.attribs["ID"].dxf.height = text_height

        if z != 0.0:
            ref.dxf.insert = (x, y, z)

    doc.saveas(dxf_path)
    return len(points)


def dxf_to_pdf(dxf_path: Path, pdf_path: Path) -> bool:
    try:
        doc = ezdxf.readfile(dxf_path)
        drawing_matplotlib.qsave(doc.modelspace(), str(pdf_path), dpi=150)
        return True
    except Exception as e:
        logger.error(f"Ошибка PDF: {e}")
        return False


