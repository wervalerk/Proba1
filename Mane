def parse_points_from_txt(text: str) -> List[Tuple[int, float, float, float]]:
    points = []
    auto_id = 1
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        s = line.replace(";", " ").replace("\t", " ")
        if re.search(r"\s", s):
            s = re.sub(r"(?<=\d),(?=\d)", ".", s)
            s = s.replace(",", " ")
            parts = s.split()
        else:
            parts = s.split(",")
        parts = [p.strip() for p in parts if p.strip()]
        if len(parts) < 2:
            continue
        nums = []
        for p in parts:
            try:
                nums.append(float(p.replace(",", ".")))
            except ValueError:
                continue
        if len(nums) < 2:
            continue
        if len(nums) >= 3 and float(nums[0]).is_integer() and abs(nums[0]) < 1e6:
            point_id = int(nums[0])
            x, y = nums[1], nums[2]
            z = nums[3] if len(nums) > 3 else 0.0
        else:
            point_id = auto_id
            x, y = nums[0], nums[1]
            z = nums[2] if len(nums) > 2 else 0.0
            auto_id += 1
        points.append((point_id, x, y, z))
    return points


SUPPORTED = {"LWPOLYLINE", "POLYLINE", "LINE", "ARC"}


def walk(entities, depth=0):
    for e in entities:
        if e.dxftype() == "INSERT" and depth < 3:
            try:
                yield from walk(e.virtual_entities(), depth + 1)
            except Exception:
                continue
        else:
            yield e


def manual_pts(e):
    t = e.dxftype()
    if t == "LWPOLYLINE":
        z = float(e.dxf.get("elevation", 0.0) or 0.0)
        return [(p[0], p[1], z) for p in e.get_points("xy")], bool(getattr(e, "closed", False))
    if t == "POLYLINE":
        return [
            (v.dxf.location.x, v.dxf.location.y, v.dxf.location.z)
            for v in e.vertices
        ], bool(getattr(e, "is_closed", False))
    if t == "LINE":
        s, e2 = e.dxf.start, e.dxf.end
        return [(s.x, s.y, s.z), (e2.x, e2.y, e2.z)], False
    if t == "ARC":
        c, r = e.dxf.center, e.dxf.radius
        a0, a1 = e.dxf.start_angle, e.dxf.end_angle
        if a1 < a0:
            a1 += 360.0
        n = max(16, int((a1 - a0) / 5) + 1)
        return [
            (
                c.x + r * math.cos(math.radians(a0 + (a1 - a0) * i / (n - 1))),
                c.y + r * math.sin(math.radians(a0 + (a1 - a0) * i / (n - 1))),
                c.z,
            )
            for i in range(n)
        ], False
    return [], False


def raw_path(e):
    if e.dxftype() not in SUPPORTED:
        return None
    try:
        ext = bbox.extents([e])
        local = max(
            abs(ext.extmin.x), abs(ext.extmin.y),
            abs(ext.extmax.x), abs(ext.extmax.y),
        )
    except Exception:
        local = 1000.0
    flat = max(local * 2e-4, 1e-3)
    try:
        p = make_path(e)
        pts = [(v.x, v.y, v.z) for v in p.flattening(flat)]
        closed = bool(getattr(p, "is_closed", False))
    except Exception:
        pts, closed = manual_pts(e)
    closed = (
        closed
        or bool(getattr(e, "closed", False))
        or bool(getattr(e, "is_closed", False))
    )
    if len(pts) < 2:
        return None
    if closed and math.hypot(pts[-1][0] - pts[0][0], pts[-1][1] - pts[0][1]) > 1e-9:
        pts.append(pts[0])
    return {"pts": pts, "closed": closed, "layer": e.dxf.layer}


def choose_scale(doc, maxabs: float, override: Optional[str] = None):
    if override:
        return {"m": 1.0, "cm": 0.01, "mm": 0.001}[override], f"DXFUNITS={override}"
    u = int(doc.header.get("$INSUNITS", 0) or 0)
    tbl = {1: 0.0254, 2: 0.3048, 4: 0.001, 5: 0.01, 6: 1.0, 7: 1000.0, 10: 0.9144}
    if u in tbl:
        return tbl[u], f"$INSUNITS={u}"
    if maxabs > 1000.0:
        return 0.001, "$INSUNITS=0 → мм"
    return 1.0, "$INSUNITS=0 → м"


@dataclass
class DxfGeom:
    polylines: List[Tuple[List[Tuple[float, float, float]], bool, str]]
    segments: List[Seg]
    scale_note: str
    has_z: bool


def parse_dxf_geom(
    path: Path,
    shift: Tuple[float, float] = (0.0, 0.0),
    dxfunits_override: Optional[str] = None,
) -> DxfGeom:
    doc = ezdxf.readfile(str(path))
    raw = [r for r in (raw_path(e) for e in walk(doc.modelspace())) if r]
    if not raw:
        raise ValueError("Не найдено LWPOLYLINE / POLYLINE / LINE / ARC (в т.ч. в блоках).")
    coords = [v for r in raw for p in r["pts"] for v in (p[0], p[1])]
    scale, note = choose_scale(doc, max(abs(v) for v in coords), dxfunits_override)
    dx, dy = shift
    polylines, segments = [], []
    contour_z = []
    for r in raw:
        pts_m = [(x * scale + dx, y * scale + dy, z * scale) for x, y, z in r["pts"]]
        contour_z.append(sum(p[2] for p in pts_m) / len(pts_m))
        polylines.append((pts_m, r["closed"], r["layer"]))
        for a, b in zip(pts_m, pts_m[1:]):
            if (b[0] - a[0]) ** 2 + (b[1] - a[1]) ** 2 < 1e-18:
                continue
            segments.append(Seg(*a, *b, r["layer"]))
    if not segments:
        raise ValueError("После приведения единиц не осталось отрезков.")
    distinct = {round(z, 3) for z in contour_z}
    has_z = len(distinct) > 1 or any(abs(z) > 1e-9 for z in contour_z)
    return DxfGeom(polylines, segments, note, has_z)


