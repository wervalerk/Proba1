async def list_files(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    files = sorted(
        (WORK_DIR / f"user_{user_id}").glob("*.dxf") if (WORK_DIR / f"user_{user_id}").exists() else [],
        key=lambda x: x.stat().st_mtime,
        reverse=True,
    )
    if not files:
        await update.message.reply_text("Пока нет DXF-файлов.")
        return
    text = "Ваши DXF-файлы:\n\n"
    for i, f in enumerate(files[:20], 1):
        text += f"{i}. `{f.name}`\n"
    await update.message.reply_text(text, parse_mode="Markdown")


async def cancel(update: Update, context: ContextTypes.DEFAULT_TYPE):
    context.user_data.clear()
    await update.message.reply_text("Отменено. /start")
    return ConversationHandler.END


async def handle_txt(update: Update, context: ContextTypes.DEFAULT_TYPE):
    document = update.message.document
    if not document or not (document.file_name or "").lower().endswith(".txt"):
        await update.message.reply_text("Нужен файл `.txt`")
        return ConversationHandler.END

    await update.message.reply_text("Читаю файл…")
    file = await context.bot.get_file(document.file_id)
    tmp = user_tmp(update.effective_user.id)
    txt_path = tmp / "points.txt"
    await file.download_to_drive(txt_path)

    text = txt_path.read_text(encoding="utf-8", errors="ignore")
    points = parse_points_from_txt(text)
    if not points:
        await update.message.reply_text("Не найдено ни одной точки.")
        return ConversationHandler.END

    context.user_data.clear()
    context.user_data["points"] = points
    context.user_data["swap_xy"] = False
    context.user_data["shift"] = (0.0, 0.0)
    context.user_data["_uid"] = update.effective_user.id

    preview = text.strip()[-600:]
    if len(text) > 600:
        preview = "…\n" + preview

    keyboard = InlineKeyboardMarkup([
        [InlineKeyboardButton("✅ Продолжить", callback_data="confirm_yes")],
        [InlineKeyboardButton("❌ Отмена", callback_data="confirm_no")],
    ])
    await update.message.reply_text(
        f"Найдено точек: *{len(points)}*\n\n```\n{preview}\n```",
        reply_markup=keyboard,
        parse_mode="Markdown",
    )
    return WAITING_CONFIRM


async def handle_confirm(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()

    if query.data != "confirm_yes":
        await query.edit_message_text("Отменено.")
        return ConversationHandler.END

    points = context.user_data["points"]
    auto_c, auto_t = calculate_auto_sizes(points)
    await query.edit_message_text(
        "Выберите размер креста и высоту текста:",
        reply_markup=sizes_keyboard(auto_c, auto_t),
    )
    return WAITING_SIZES


async def handle_size_choice(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    data = query.data
    points = context.user_data["points"]

    if data == "size_custom":
        await query.edit_message_text(
            "Напишите два числа: размер креста и высоту текста\n"
            "Например: `0.55 0.75`",
            parse_mode="Markdown",
        )
        return WAITING_CUSTOM_SIZE

    if data == "size_auto":
        cross, text_h = calculate_auto_sizes(points)
    else:
        parts = data.replace("size_", "").split("_")
        cross = float(parts[0])
        text_h = float(parts[1])

    context.user_data["cross_size"] = cross
    context.user_data["text_height"] = text_h
    context.user_data["_uid"] = query.from_user.id
    try:
        await query.delete_message()
    except Exception:
        pass
    return await send_preview_photo(query.message.chat_id, context)


async def handle_custom_size(update: Update, context: ContextTypes.DEFAULT_TYPE):
    text = update.message.text.strip()
    nums = re.findall(r"[\d.,]+", text)
    nums = [float(n.replace(",", ".")) for n in nums]
    if len(nums) < 2:
        await update.message.reply_text("Нужно два числа. Пример: `0.5 0.7`", parse_mode="Markdown")
        return WAITING_CUSTOM_SIZE

    cross = max(0.15, min(nums[0], 4.0))
    text_h = max(0.2, min(nums[1], 5.0))
    context.user_data["cross_size"] = cross
    context.user_data["text_height"] = text_h
    context.user_data["_uid"] = update.effective_user.id

    return await send_preview_photo(update.effective_chat.id, context)


async def send_preview_photo(chat_id: int, context: ContextTypes.DEFAULT_TYPE):
    points = context.user_data["points"]
    cross = context.user_data["cross_size"]
    text_h = context.user_data["text_height"]
    user_id = context.user_data.get("_uid") or 0

    tmp = user_tmp(user_id)
    preview_path = tmp / "preview.png"
    create_preview_image(points, cross, text_h, preview_path)

    caption = (
        f"Превью точек\n"
        f"Крест: *{cross}*   Текст: *{text_h}*\n\n"
        "Можно сразу создать DXF или добавить DXF-проект как *подложку* "
        "(с проверкой системы координат)."
    )
    with open(preview_path, "rb") as f:
        await context.bot.send_photo(
            chat_id=chat_id,
            photo=f,
            caption=caption,
            parse_mode="Markdown",
            reply_markup=preview_keyboard(),
        )
    return WAITING_PREVIEW


