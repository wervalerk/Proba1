async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "Привет! Я добавляю точки из TXT в DXF.\n\n"
        "1. Пришлите .txt файл с точками\n"
        "2. Напишите имя файла или пришлите готовый .dxf\n\n"
        "Поддерживаемые форматы:\n"
        "<code>1 100.5 200.3 15.0</code>\n"
        "<code>1,100.5,200.3,15.0</code>\n"
        "<code>100,5 200,3 15,0</code>\n\n"
        "Команды:\n"
        "/view — посмотреть последний TXT\n"
        "/list — список ваших DXF\n"
        "/pdf — сделать PDF\n"
        "/cancel — отмена",
        parse_mode="HTML"
    )


async def view_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    txt_path = WORK_DIR / f"user_{update.effective_user.id}_points.txt"
    if not txt_path.exists():
        await update.message.reply_text("Сначала пришлите TXT файл.")
        return

    try:
        text = txt_path.read_text(encoding="utf-8", errors="ignore")
    except Exception as e:
        await update.message.reply_text(f"Ошибка чтения: {e}")
        return

    preview = text.strip()[-3500:]
    if len(text) > 3500:
        preview = "...\n" + preview

    await update.message.reply_text(
        f"<b>Содержимое файла:</b>\n<pre>{preview}</pre>",
        parse_mode="HTML"
    )


async def list_files(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    files = get_user_dxf_files(user_id)

    if not files:
        await update.message.reply_text("У вас пока нет DXF-файлов.")
        return

    text = "Ваши DXF-файлы:\n\n"
    for i, f in enumerate(files, 1):
        name = get_display_name(f, user_id)
        size_kb = f.stat().st_size / 1024
        text += f"{i}. {name}  ({size_kb:.1f} КБ)\n"

    await update.message.reply_text(text)


async def handle_txt(update: Update, context: ContextTypes.DEFAULT_TYPE):
    document = update.message.document
    if not document or not (document.file_name or "").lower().endswith(".txt"):
        await update.message.reply_text("Нужен файл с расширением .txt")
        return ConversationHandler.END

    await update.message.reply_text("Читаю файл...")

    file = await context.bot.get_file(document.file_id)
    txt_path = WORK_DIR / f"user_{update.effective_user.id}_points.txt"
    await file.download_to_drive(txt_path)

    try:
        text = txt_path.read_text(encoding="utf-8", errors="ignore")
    except Exception as e:
        await update.message.reply_text(f"Не удалось прочитать файл: {e}")
        return ConversationHandler.END

    points = parse_points_from_txt(text)
    if not points:
        await update.message.reply_text("Не найдено ни одной валидной точки.")
        return ConversationHandler.END

    context.user_data["points"] = points

    preview = text.strip()[-800:]
    if len(text) > 800:
        preview = "...\n" + preview

    keyboard = InlineKeyboardMarkup([
        [InlineKeyboardButton("✅ Продолжить", callback_data="confirm_yes")],
        [InlineKeyboardButton("❌ Отмена", callback_data="confirm_no")],
    ])

    await update.message.reply_text(
        f"Найдено точек: <b>{len(points)}</b>\n\n"
        f"Проверьте данные:\n<pre>{preview}</pre>",
        reply_markup=keyboard,
        parse_mode="HTML"
    )
    return WAITING_CONFIRM


async def handle_confirm(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()

    if query.data == "confirm_yes":
        await query.edit_message_text(
            "Файл принят.\n\n"
            "Теперь:\n"
            "• Напишите имя нового файла (например: scheme.dxf)\n"
            "• Или пришлите готовый DXF-файл\n"
            "• Или укажите номер из списка /list"
        )
        return WAITING_DXF
    else:
        await query.edit_message_text("Отменено. Можете прислать другой TXT.")
        return ConversationHandler.END


async def handle_dxf_or_name(update: Update, context: ContextTypes.DEFAULT_TYPE):
    points = context.user_data.get("points")
    if not points:
        await update.message.reply_text("Сначала отправьте TXT с точками.")
        return ConversationHandler.END

    user_id = update.effective_user.id
    files = get_user_dxf_files(user_id)
    dxf_path = None

    if update.message.document:
        document = update.message.document
        file_name = document.file_name or ""
        if not file_name.lower().endswith(".dxf"):
            await update.message.reply_text("Нужен файл .dxf")
            return WAITING_DXF

        file = await context.bot.get_file(document.file_id)
        safe_name = re.sub(r'[\\/*?:"<>|]', "_", file_name)
        dxf_path = WORK_DIR / f"user_{user_id}_{safe_name}"
        await file.download_to_drive(dxf_path)

    elif update.message.text:
        text = update.message.text.strip()

        if text.isdigit():
            idx = int(text) - 1
            if 0 <= idx < len(files):
                dxf_path = files[idx]
            else:
                await update.message.reply_text("Неверный номер файла.")
                return WAITING_DXF
        else:
            name = text
            if not name.lower().endswith(".dxf"):
                name += ".dxf"
            name = re.sub(r'[\\/*?:"<>|]', "_", name)
            dxf_path = WORK_DIR / f"user_{user_id}_{name}"
    else:
        await update.message.reply_text("Пришлите DXF или напишите имя файла.")
        return WAITING_DXF

    await update.message.reply_text("Добавляю точки в DXF...")

    try:
        added = add_points_to_dxf(dxf_path, points)
        doc = ezdxf.readfile(dxf_path)
        total = len(list(doc.modelspace().query("INSERT")))
    except Exception as e:
        logger.exception("Ошибка при создании DXF")
        await update.message.reply_text(f"Ошибка: {e}")
        return ConversationHandler.END

    display_name = get_display_name(dxf_path, user_id)
    context.user_data["last_dxf"] = str(dxf_path)

    keyboard = InlineKeyboardMarkup([
        [InlineKeyboardButton("📄 Сделать PDF", callback_data="make_pdf")]
    ])

    await update.message.reply_text(
        f"✅ Готово!\n"
        f"Файл: <b>{display_name}</b>\n"
        f"Добавлено точек: {added}\n"
        f"Всего блоков точек: {total}",
        parse_mode="HTML",
        reply_markup=keyboard
    )

    with open(dxf_path, "rb") as f:
        await update.message.reply_document(
            document=f,
            filename=display_name,
            caption="DXF с точками и номерами"
        )

    return ConversationHandler.END


async def button_make_pdf(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()

    dxf_path_str = context.user_data.get("last_dxf")
    if not dxf_path_str or not Path(dxf_path_str).exists():
        await query.edit_message_text("Файл не найден. Начните заново.")
        return

    await query.edit_message_text("Создаю PDF...")

    dxf_path = Path(dxf_path_str)
    pdf_path = dxf_path.with_suffix(".pdf")

    if dxf_to_pdf(dxf_path, pdf_path):
        display_name = get_display_name(pdf_path, update.effective_user.id)
        with open(pdf_path, "rb") as f:
            await context.bot.send_document(
                chat_id=query.message.chat_id,
                document=f,
                filename=display_name,
                caption="PDF готов"
            )
        await query.edit_message_text("PDF отправлен ✅")
    else:
        await query.edit_message_text("Не удалось создать PDF")


async def pdf_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    files = get_user_dxf_files(user_id)

    if not files:
        await update.message.reply_text("У вас нет DXF-файлов.")
        return

    buttons = []
    for i, f in enumerate(files):
        name = get_display_name(f, user_id)
        buttons.append([InlineKeyboardButton(f"{i+1}. {name}", callback_data=f"pdf_{i}")])

    await update.message.reply_text(
        "Выберите файл для PDF:",
        reply_markup=InlineKeyboardMarkup(buttons)
    )


async def button_pdf_choice(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()

    try:
        idx = int(query.data.split("_")[1])
    except (IndexError, ValueError):
        await query.edit_message_text("Ошибка выбора файла.")
        return

    user_id = update.effective_user.id
    files = get_user_dxf_files(user_id)

    if idx < 0 or idx >= len(files):
        await query.edit_message_text("Файл не найден.")
        return

    dxf_path = files[idx]
    await query.edit_message_text(f"Делаю PDF из «{get_display_name(dxf_path, user_id)}»...")

    pdf_path = dxf_path.with_suffix(".pdf")

    if dxf_to_pdf(dxf_path, pdf_path):
        display_name = get_display_name(pdf_path, user_id)
        with open(pdf_path, "rb") as f:
            await context.bot.send_document(
                chat_id=query.message.chat_id,
                document=f,
                filename=display_name,
                caption="PDF готов"
            )
        await query.edit_message_text("PDF отправлен ✅")
    else:
        await query.edit_message_text("Не удалось создать PDF")


async def cancel(update: Update, context: ContextTypes.DEFAULT_TYPE):
    context.user_data.clear()
    await update.message.reply_text("Операция отменена.")
    return ConversationHandler.END


# ================== ЗАПУСК ==================

def main():
    if BOT_TOKEN == "ВАШ_ТОКЕН_ОТ_BOTFATHER" or not BOT_TOKEN.strip():
        print("Ошибка: укажите токен бота в переменной BOT_TOKEN")
        return

    app = Application.builder().token(BOT_TOKEN).build()

    conv_handler = ConversationHandler(
        entry_points=[MessageHandler(filters.Document.FileExtension("txt"), handle_txt)],
        states={
            WAITING_CONFIRM: [CallbackQueryHandler(handle_confirm)],
            WAITING_DXF: [
                MessageHandler(filters.Document.FileExtension("dxf"), handle_dxf_or_name),
                MessageHandler(filters.TEXT & ~filters.COMMAND, handle_dxf_or_name),
            ],
        },
        fallbacks=[CommandHandler("cancel", cancel)],
        allow_reentry=True,
    )

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("view", view_command))
    app.add_handler(CommandHandler("list", list_files))
    app.add_handler(CommandHandler("pdf", pdf_command))
    app.add_handler(CommandHandler("cancel", cancel))
    app.add_handler(conv_handler)

    # Важно: регистрируем обработчики кнопок
    app.add_handler(CallbackQueryHandler(button_make_pdf, pattern="^make_pdf$"))
    app.add_handler(CallbackQueryHandler(button_pdf_choice, pattern="^pdf_"))

    print("Бот запущен...")
    app.run_polling(allowed_updates=Update.ALL_TYPES)


if __name__ == "__main__":
    main()
