async def handle_size_choice(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    data = query.data
    points = context.user_data["points"]

    if data == "size_custom":
        await query.edit_message_text(
            "Напишите два числа: размер креста и высоту текста\n"
            "Например: <code>0.55 0.75</code>",
            parse_mode="HTML"
        )
        context.user_data["waiting_custom_size"] = True
        return WAITING_SIZES

    if data == "size_auto":
        cross, text = calculate_auto_sizes(points)
    else:
        # size_0.6_0.8
        parts = data.replace("size_", "").split("_")
        cross = float(parts[0])
        text = float(parts[1])

    context.user_data["cross_size"] = cross
    context.user_data["text_height"] = text

    # Превью
    preview_path = WORK_DIR / f"user_{update.effective_user.id}_preview.png"
    create_preview_image(points, cross, text, preview_path)

    keyboard = InlineKeyboardMarkup([
        [InlineKeyboardButton("✅ Создать DXF", callback_data="create_yes")],
        [InlineKeyboardButton("🔄 Изменить размеры", callback_data="create_change")],
        [InlineKeyboardButton("📂 Загрузить другой DXF", callback_data="create_upload")],
    ])

    with open(preview_path, "rb") as f:
        await context.bot.send_photo(
            chat_id=query.message.chat_id,
            photo=f,
            caption=f"Превью\nКрест: <b>{cross}</b>   Текст: <b>{text}</b>",
            parse_mode="HTML",
            reply_markup=keyboard
        )
    await query.delete_message()
    return WAITING_PREVIEW


async def handle_custom_size(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not context.user_data.get("waiting_custom_size"):
        return WAITING_SIZES

    text = update.message.text.strip()
    nums = re.findall(r"[\d.,]+", text)
    nums = [float(n.replace(",", ".")) for n in nums]

    if len(nums) < 2:
        await update.message.reply_text("Нужно два числа. Пример: 0.5 0.7")
        return WAITING_SIZES

    cross, text_h = nums[0], nums[1]
    cross = max(0.15, min(cross, 4.0))
    text_h = max(0.2, min(text_h, 5.0))

    context.user_data["cross_size"] = cross
    context.user_data["text_height"] = text_h
    context.user_data.pop("waiting_custom_size", None)

    points = context.user_data["points"]
    preview_path = WORK_DIR / f"user_{update.effective_user.id}_preview.png"
    create_preview_image(points, cross, text_h, preview_path)

    keyboard = InlineKeyboardMarkup([
        [InlineKeyboardButton("✅ Создать DXF", callback_data="create_yes")],
        [InlineKeyboardButton("🔄 Изменить размеры", callback_data="create_change")],
        [InlineKeyboardButton("📂 Загрузить другой DXF", callback_data="create_upload")],
    ])

    with open(preview_path, "rb") as f:
        await update.message.reply_photo(
            photo=f,
            caption=f"Превью\nКрест: <b>{cross}</b>   Текст: <b>{text_h}</b>",
            parse_mode="HTML",
            reply_markup=keyboard
        )
    return WAITING_PREVIEW


async def handle_preview(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    data = query.data
    user_id = update.effective_user.id

    if data == "create_change":
        await ask_sizes(query, context)
        return WAITING_SIZES

    if data == "create_upload":
        await query.edit_message_caption(caption="Пришлите DXF-файл, в который нужно добавить точки:")
        context.user_data["waiting_upload"] = True
        return WAITING_DXF_CHOICE

    # Создаём файл
    points = context.user_data["points"]
    dxf_path = Path(context.user_data["dxf_path"])
    cross = context.user_data["cross_size"]
    text_h = context.user_data["text_height"]

    await query.edit_message_caption(caption="Создаю DXF...")

    try:
        added = add_points_to_dxf(dxf_path, points, cross, text_h)
    except Exception as e:
        await query.edit_message_caption(caption=f"Ошибка: {e}")
        return ConversationHandler.END

    display_name = get_display_name(dxf_path, user_id)
    context.user_data["last_dxf"] = str(dxf_path)

    keyboard = InlineKeyboardMarkup([
        [InlineKeyboardButton("📄 Сделать PDF", callback_data="make_pdf")]
    ])

    await context.bot.send_message(
        chat_id=query.message.chat_id,
        text=f"✅ Готово!\nФайл: <b>{display_name}</b>\nТочек: {added}\nКрест: {cross}  |  Текст: {text_h}",
        parse_mode="HTML",
        reply_markup=keyboard
    )
    with open(dxf_path, "rb") as f:
        await context.bot.send_document(chat_id=query.message.chat_id, document=f, filename=display_name)

    return ConversationHandler.END


async def button_make_pdf(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    path = context.user_data.get("last_dxf")
    if not path or not Path(path).exists():
        await query.answer("Файл не найден", show_alert=True)
        return
    await query.edit_message_text("Делаю PDF...")
    pdf_path = Path(path).with_suffix(".pdf")
    if dxf_to_pdf(Path(path), pdf_path):
        with open(pdf_path, "rb") as f:
            await context.bot.send_document(chat_id=query.message.chat_id, document=f,
                                            filename=get_display_name(pdf_path, update.effective_user.id))
        await query.edit_message_text("PDF отправлен ✅")
    else:
        await query.edit_message_text("Ошибка PDF")


async def cancel(update: Update, context: ContextTypes.DEFAULT_TYPE):
    context.user_data.clear()
    await update.message.reply_text("Отменено.")
    return ConversationHandler.END


def main():
    if BOT_TOKEN == "ВАШ_ТОКЕН_ОТ_BOTFATHER":
        print("Укажите токен!")
        return

    app = Application.builder().token(BOT_TOKEN).build()

    conv = ConversationHandler(
        entry_points=[MessageHandler(filters.Document.FileExtension("txt"), handle_txt)],
        states={
            WAITING_CONFIRM: [CallbackQueryHandler(handle_confirm)],
            WAITING_DXF_CHOICE: [
                CallbackQueryHandler(handle_dxf_choice),
                MessageHandler(filters.Document.ALL | filters.TEXT, handle_dxf_input),
            ],
            WAITING_SIZES: [
                CallbackQueryHandler(handle_size_choice),
                MessageHandler(filters.TEXT & ~filters.COMMAND, handle_custom_size),
            ],
            WAITING_PREVIEW: [CallbackQueryHandler(handle_preview)],
        },
        fallbacks=[CommandHandler("cancel", cancel)],
        allow_reentry=True,
    )

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("list", list_files))
    app.add_handler(CommandHandler("cancel", cancel))
    app.add_handler(conv)
    app.add_handler(CallbackQueryHandler(button_make_pdf, pattern="^make_pdf$"))

    print("Бот запущен...")
    app.run_polling(allowed_updates=Update.ALL_TYPES)


if __name__ == "__main__":
    main()
