async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    context.user_data.clear()
    await update.message.reply_text(
        "Привет! Бот добавляет точки из TXT в DXF.\n\n"
        "1. Пришлите `.txt` файл с точками\n"
        "2. Подтвердите → выберите размер креста/текста\n"
        "3. Посмотрите превью\n"
        "4. Создайте DXF *или* добавьте DXF как *подложку*\n"
        "   (при подложке работает проверка системы координат)\n\n"
        "/list — ваши DXF\n/cancel — отмена"
    )


async def list_files(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    files = sorted(
        (WORK_DIR / f"user_{user_id}").glob("*.dxf") if (WORK_DIR / f"user_{user_id}").exists() else [],
        key=lambda x: x.stat().st_mtime,
        reverse=True,
    )
    if not files:
        await update.message.reply_text("Пока нет DXF-файлов.")
        return
    text = "Ваши DXF-файлы:\n\n"
    for i, f in enumerate(files[:20], 1):
        text += f"{i}. `{f.name}`\n"
    await update.message.reply_text(text, parse_mode="Markdown")


async def cancel(update: Update, context: ContextTypes.DEFAULT_TYPE):
    context.user_data.clear()
    await update.message.reply_text("Отменено. /start")
    return ConversationHandler.END


async def handle_txt(update: Update, context: ContextTypes.DEFAULT_TYPE):
    document = update.message.document
    if not document or not (document.file_name or "").lower().endswith(".txt"):
        await update.message.reply_text("Нужен файл `.txt`")
        return ConversationHandler.END

    await update.message.reply_text("Читаю файл…")
    file = await context.bot.get_file(document.file_id)
    tmp = user_tmp(update.effective_user.id)
    txt_path = tmp / "points.txt"
    await file.download_to_drive(txt_path)

    text = txt_path.read_text(encoding="utf-8", errors="ignore")
    points = parse_points_from_txt(text)
    if not points:
        await update.message.reply_text("Не найдено ни одной точки.")
        return ConversationHandler.END

    context.user_data.clear()
    context.user_data["points"] = points
    context.user_data["swap_xy"] = False
    context.user_data["shift"] = (0.0, 0.0)
    context.user_data["_uid"] = update.effective_user.id

    preview = text.strip()[-600:]
    if len(text) > 600:
        preview = "…\n" + preview

    keyboard = InlineKeyboardMarkup([
        [InlineKeyboardButton("✅ Продолжить", callback_data="confirm_yes")],
        [InlineKeyboardButton("❌ Отмена", callback_data="confirm_no")],
    ])
    await update.message.reply_text(
        f"Найдено точек: *{len(points)}*\n\n```\n{preview}\n```",
        reply_markup=keyboard,
        parse_mode="Markdown",
    )
    return WAITING_CONFIRM


async def handle_confirm(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()

    if query.data != "confirm_yes":
        await query.edit_message_text("Отменено.")
        return ConversationHandler.END

    points = context.user_data["points"]
    auto_c, auto_t = calculate_auto_sizes(points)
    await query.edit_message_text(
        "Выберите размер креста и высоту текста:",
        reply_markup=sizes_keyboard(auto_c, auto_t),
    )
    return WAITING_SIZES


async def handle_size_choice(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    data = query.data
    points = context.user_data["points"]

    if data == "size_custom":
        await query.edit_message_text(
            "Напишите два числа: размер креста и высоту текста\n"
            "Например: `0.55 0.75`",
            parse_mode="Markdown",
        )
        return WAITING_CUSTOM_SIZE

    if data == "size_auto":
        cross, text_h = calculate_auto_sizes(points)
    else:
        parts = data.replace("size_", "").split("_")
        cross = float(parts[0])
        text_h = float(parts[1])

    context.user_data["cross_size"] = cross
    context.user_data["text_height"] = text_h
    context.user_data["_uid"] = query.from_user.id
    try:
        await query.delete_message()
    except Exception:
        pass
    return await send_preview_photo(query.message.chat_id, context)


async def handle_custom_size(update: Update, context: ContextTypes.DEFAULT_TYPE):
    text = update.message.text.strip()
    nums = re.findall(r"[\d.,]+", text)
    nums = [float(n.replace(",", ".")) for n in nums]
    if len(nums) < 2:
        await update.message.reply_text("Нужно два числа. Пример: `0.5 0.7`", parse_mode="Markdown")
        return WAITING_CUSTOM_SIZE

    cross = max(0.15, min(nums[0], 4.0))
    text_h = max(0.2, min(nums[1], 5.0))
    context.user_data["cross_size"] = cross
    context.user_data["text_height"] = text_h
    context.user_data["_uid"] = update.effective_user.id

    return await send_preview_photo(update.effective_chat.id, context)


async def send_preview_photo(chat_id: int, context: ContextTypes.DEFAULT_TYPE):
    points = context.user_data["points"]
    cross = context.user_data["cross_size"]
    text_h = context.user_data["text_height"]
    user_id = context.user_data.get("_uid") or 0

    tmp = user_tmp(user_id)
    preview_path = tmp / "preview.png"
    create_preview_image(points, cross, text_h, preview_path)

    caption = (
        f"Превью точек\n"
        f"Крест: *{cross}*   Текст: *{text_h}*\n\n"
        "Можно сразу создать DXF или добавить DXF-проект как *подложку* "
        "(с проверкой системы координат)."
    )
    with open(preview_path, "rb") as f:
        await context.bot.send_photo(
            chat_id=chat_id,
            photo=f,
            caption=caption,
            parse_mode="Markdown",
            reply_markup=preview_keyboard(),
        )
    return WAITING_PREVIEW


async def handle_preview(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    data = query.data
    user_id = update.effective_user.id
    context.user_data["_uid"] = user_id

    if data == "change_sizes":
        points = context.user_data["points"]
        auto_c, auto_t = calculate_auto_sizes(points)
        await query.edit_message_caption(
            caption="Выберите размер креста и высоту текста:",
            reply_markup=sizes_keyboard(auto_c, auto_t),
        )
        return WAITING_SIZES

    if data == "add_underlay":
        await query.edit_message_caption(
            caption="Пришлите DXF-файл, который станет *подложкой* (контуры проекта).\n"
                    "После загрузки будет проверка системы координат.",
            parse_mode="Markdown",
        )
        context.user_data["waiting_underlay"] = True
        return WAITING_UNDERLAY

    if data == "create_plain":
        return await do_create_dxf(query, context, underlay=None)


async def handle_underlay_upload(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not context.user_data.get("waiting_underlay"):
        return WAITING_UNDERLAY

    document = update.message.document
    if not document or not (document.file_name or "").lower().endswith(".dxf"):
        await update.message.reply_text("Нужен файл `.dxf`")
        return WAITING_UNDERLAY

    user_id = update.effective_user.id
    tmp = user_tmp(user_id)
    underlay_path = tmp / "underlay.dxf"
    file = await context.bot.get_file(document.file_id)
    await file.download_to_drive(underlay_path)

    context.user_data["underlay_path"] = str(underlay_path)
    context.user_data.pop("waiting_underlay", None)
    context.user_data["swap_xy"] = False
    context.user_data["shift"] = (0.0, 0.0)

    await update.message.reply_text("DXF принят. Запускаю *Модуль 0* — проверку СК…", parse_mode="Markdown")
    return await run_cs_check(update, context)


async def run_cs_check(update: Update, context: ContextTypes.DEFAULT_TYPE, force: bool = False):
    points = context.user_data.get("points")
    underlay_path = context.user_data.get("underlay_path")
    if not points or not underlay_path or not Path(underlay_path).exists():
        await update.effective_message.reply_text("Файлы потеряны — /start")
        return ConversationHandler.END

    shift = tuple(context.user_data.get("shift", (0.0, 0.0)))
    swap = bool(context.user_data.get("swap_xy"))

    pts_for_check = points
    if swap:
        pts_for_check = [(pid, y, x, z) for pid, x, y, z in points]

    try:
        geom = parse_dxf_geom(Path(underlay_path), shift=shift)
    except Exception as e:
        await update.effective_message.reply_text(
            f"Ошибка чтения DXF: `{e}`\nПришлите другой файл или /cancel",
            parse_mode="Markdown",
        )
        return WAITING_UNDERLAY

    context.user_data["underlay_geom"] = geom
    rep = check_cs(pts_for_check, geom.segments, shift)

    text = cs_text(rep, shift, swapped=swap)
    msg = update.effective_message
    if rep.ok:
        await msg.reply_text(text, parse_mode="Markdown")
        keyboard = InlineKeyboardMarkup([
            [InlineKeyboardButton("✅ Создать DXF с подложкой", callback_data="create_with_underlay")],
            [InlineKeyboardButton("🔁 Перепроверить СК", callback_data="cs_recheck")],
        ])
        tmp = user_tmp(update.effective_user.id)
        preview_path = tmp / "preview_cs.png"
        cross = context.user_data["cross_size"]
        text_h = context.user_data["text_height"]
        create_preview_image(
            pts_for_check, cross, text_h, preview_path,
            underlay=geom, title_extra="подложка + СК OK",
        )
        with open(preview_path, "rb") as f:
            await context.bot.send_photo(
                chat_id=msg.chat_id,
                photo=f,
                caption="СК в порядке. Можно создавать файл.",
                reply_markup=keyboard,
            )
        return WAITING_CS
    else:
        await msg.reply_text(text, parse_mode="Markdown", reply_markup=cs_kb(swap))
        return WAITING_CS


async def cs_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    data = query.data

    if data == "cs_swap":
        context.user_data["swap_xy"] = not bool(context.user_data.get("swap_xy"))
        await query.edit_message_text("Ориентация переключена, перепроверяю…")
        return await run_cs_check(update, context, force=True)

    if data == "cs_keep":
        await query.edit_message_text("Оставляю текущую ориентацию / сдвиг.")
        keyboard = InlineKeyboardMarkup([
            [InlineKeyboardButton("✅ Создать DXF с подложкой", callback_data="create_with_underlay")],
        ])
        await query.message.reply_text(
            "Можно создать файл (с предупреждением, если СК далеко).",
            reply_markup=keyboard,
        )
        return WAITING_CS

    if data == "cs_shift":
        await query.message.reply_text(
            "Пришлите `X0 Y0` в метрах (оси DXF), например:\n`2860.000 9500.000`",
            parse_mode="Markdown",
        )
        return WAITING_SHIFT

    if data == "cs_recheck":
        await query.answer("Перепроверяю…")
        return await run_cs_check(update, context, force=True)

    if data == "create_with_underlay":
        return await do_create_dxf(query, context, underlay=context.user_data.get("underlay_geom"))


async def handle_shift_input(update: Update, context: ContextTypes.DEFAULT_TYPE):
    m = re.match(r"^\s*([+-]?[\d.,]+)[;\s]+([+-]?[\d.,]+)\s*$", update.message.text or "")
    if not m:
        await update.message.reply_text(
            "Два числа через пробел или `;`:\n`2860.000 9500.000`",
            parse_mode="Markdown",
        )
        return WAITING_SHIFT

    def num(s):
        return float(s.replace(",", "."))

    context.user_data["shift"] = (num(m.group(1)), num(m.group(2)))
    await update.message.reply_text("SHIFT принят, перепроверяю СК…")
    return await run_cs_check(update, context, force=True)


async def do_create_dxf(query, context: ContextTypes.DEFAULT_TYPE, underlay: Optional[DxfGeom]):
    user_id = (query.from_user.id if getattr(query, "from_user", None)
               else context.user_data.get("_uid", 0))
    points = list(context.user_data["points"])
    if context.user_data.get("swap_xy"):
        points = [(pid, y, x, z) for pid, x, y, z in points]

    cross = context.user_data["cross_size"]
    text_h = context.user_data["text_height"]
    tmp = user_tmp(user_id)
    name = f"points_{datetime.now().strftime('%Y%m%d_%H%M%S')}.dxf"
    dxf_path = tmp / name
    chat_id = query.message.chat_id

    try:
        if hasattr(query, "edit_message_caption"):
            await query.edit_message_caption(caption="Создаю DXF…")
    except Exception:
        pass

    try:
        added = add_points_and_underlay_to_dxf(
            dxf_path, points, cross, text_h, underlay=underlay
        )
    except Exception as e:
        await context.bot.send_message(
            chat_id=chat_id,
            text=f"Ошибка создания DXF: `{e}`",
            parse_mode="Markdown",
        )
        return ConversationHandler.END

    context.user_data["last_dxf"] = str(dxf_path)

    note = "с подложкой" if underlay else "без подложки"
    swap_note = " (X↔Y)" if context.user_data.get("swap_xy") else ""
    shift = context.user_data.get("shift", (0.0, 0.0))
    shift_note = (
        f", SHIFT={shift[0]:.3f};{shift[1]:.3f}"
        if any(abs(v) > 1e-9 for v in shift) else ""
    )

    keyboard = InlineKeyboardMarkup([
        [InlineKeyboardButton("📄 Сделать PDF", callback_data="make_pdf")],
    ])
    await context.bot.send_message(
        chat_id=chat_id,
        text=(
            f"✅ Готово ({note}{swap_note}{shift_note})\n"
            f"Файл: `{name}`\n"
            f"Точек: {added}  |  Крест: {cross}  |  Текст: {text_h}"
        ),
        parse_mode="Markdown",
        reply_markup=keyboard,
    )
    with open(dxf_path, "rb") as f:
        await context.bot.send_document(
            chat_id=chat_id,
            document=f,
            filename=name,
        )
    return ConversationHandler.END


async def button_make_pdf(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    path = context.user_data.get("last_dxf")
    if not path or not Path(path).exists():
        await query.answer("Файл не найден", show_alert=True)
        return
    await query.edit_message_text("Делаю PDF…")
    pdf_path = Path(path).with_suffix(".pdf")
    if dxf_to_pdf(Path(path), pdf_path):
        with open(pdf_path, "rb") as f:
            await context.bot.send_document(
                chat_id=query.message.chat_id,
                document=f,
                filename=pdf_path.name,
            )
        await query.edit_message_text("PDF отправлен ✅")
    else:
        await query.edit_message_text("Ошибка при создании PDF")


def main():
    if not BOT_TOKEN or BOT_TOKEN.startswith("ВАШ"):
        print("Укажите BOT_TOKEN в коде!")
        return

    app = (
        Application.builder()
        .token(BOT_TOKEN)
        .concurrent_updates(False)
        .build()
    )

    conv = ConversationHandler(
        entry_points=[
            MessageHandler(filters.Document.FileExtension("txt"), handle_txt),
        ],
        states={
            WAITING_CONFIRM: [
                CallbackQueryHandler(handle_confirm, pattern="^confirm_"),
            ],
            WAITING_SIZES: [
                CallbackQueryHandler(handle_size_choice, pattern="^size_"),
            ],
            WAITING_CUSTOM_SIZE: [
                MessageHandler(filters.TEXT & ~filters.COMMAND, handle_custom_size),
            ],
            WAITING_PREVIEW: [
                CallbackQueryHandler(handle_preview, pattern="^(create_plain|add_underlay|change_sizes)$"),
            ],
            WAITING_UNDERLAY: [
                MessageHandler(filters.Document.FileExtension("dxf"), handle_underlay_upload),
            ],
            WAITING_CS: [
                CallbackQueryHandler(cs_callback, pattern="^(cs_|create_with_underlay)"),
            ],
            WAITING_SHIFT: [
                MessageHandler(filters.TEXT & ~filters.COMMAND, handle_shift_input),
            ],
        },
        fallbacks=[
            CommandHandler("cancel", cancel),
            CommandHandler("start", start),
        ],
        allow_reentry=True,
    )

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("list", list_files))
    app.add_handler(CommandHandler("cancel", cancel))
    app.add_handler(conv)
    app.add_handler(CallbackQueryHandler(button_make_pdf, pattern="^make_pdf$"))

    print("Бот запущен…")
    app.run_polling(allowed_updates=Update.ALL_TYPES)


if __name__ == "__main__":
    main()
