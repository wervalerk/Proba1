        app.add_handler(CommandHandler("view", view_command)) # Новая команда
        app.add_handler(CommandHandler("list", list_files))
        app.add_handler(CommandHandler("pdf", pdf_command))
        app.add_handler(CommandHandler("cancel", cancel))
